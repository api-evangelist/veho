          "name": "List serviceable ZIP codes",
          "request": {
            "name": "List serviceable ZIP codes",
            "description": {
              "content": "This endpoint returns the full list of ZIP codes currently serviced by Veho.\n>  The sandbox environment contains a subset of ZIP codes within our serviceable areas so when creating an order in the sandbox environment, make sure to use a destination ZIP code included in the sandbox serviceable ZIP list.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "serviceable-zips"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "serviceType",
                  "value": "<string>",
                  "description": "Service type for which to retrieve serviceable ZIP codes (will use `delivery` if not provided)"
                }
              ],
              "variable": []
            },
            "header": [
